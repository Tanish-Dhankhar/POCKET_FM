OPENAI_API_KEY=your_openai_api_key
OPENAI_HARD_MODEL=gpt-5.6-sol
OPENAI_EASY_MODEL=gpt-5.6-luna

# Series thumbnail + character portraits (OpenAI images).
# Off by default: nothing is generated and no image API call is made until this
# is set to true.
IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1

GEMINI_API_KEY=your_primary_key
GEMINI_API_KEYS=key_1,key_2,key_3
TTS_PARALLEL_WORKERS=3
TTS_MIN_INTERVAL_SEC=21
