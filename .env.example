OPENAI_API_KEY=your_openai_api_key
OPENAI_HARD_MODEL=gpt-5.6-sol
OPENAI_EASY_MODEL=gpt-5.6-luna

# Exact-input, model-free presentation replay. Set false outside demo builds.
DEMO_REPLAY_ENABLED=true
DEMO_REPLAY_STEP_DELAY_SEC=1.20

# Exact model-response cache. Set MODEL_CACHE_VERSION=v2 to invalidate old data.
MODEL_CACHE_ENABLED=true
MODEL_CACHE_TTL_SEC=604800

# Series thumbnail + character portraits (OpenAI images).
# Off by default: nothing is generated and no image API call is made until this
# is set to true.
IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2

GEMINI_API_KEY=your_primary_key
GEMINI_API_KEYS=key_1,key_2,key_3
TTS_PARALLEL_WORKERS=3
TTS_MIN_INTERVAL_SEC=21
# Optional resilient fallback after Gemini exhausts its retries.
TTS_OPENAI_FALLBACK_ENABLED=false
TTS_OPENAI_FALLBACK_MODEL=gpt-4o-mini-tts
